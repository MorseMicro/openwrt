From e6ab14deac9353416afd12de9263a32de8c22148 Mon Sep 17 00:00:00 2001
From: Lachlan Hodges <lachlan.hodges@morsemicro.com>
Date: Mon, 27 Oct 2025 10:54:48 +1100
Subject: [PATCH 4/9] tests: expose scan_freq_offset

Expose `scan_freq_offset` such that S1G channels can be scanned
during tests.

Signed-off-by: Lachlan Hodges <lachlan.hodges@morsemicro.com>
---
 tests/hwsim/wpasupplicant.py | 1 +
 1 file changed, 1 insertion(+)

diff --git a/tests/hwsim/wpasupplicant.py b/tests/hwsim/wpasupplicant.py
index 8d4da761d..c57984230 100644
--- a/tests/hwsim/wpasupplicant.py
+++ b/tests/hwsim/wpasupplicant.py
@@ -1136,6 +1136,7 @@ class WpaSupplicant:
                       "max_idle",
                       "ssid_protection",
                       "enable_4addr_mode"]
+                      "scan_freq_offset"]
         for field in not_quoted:
             if field in kwargs and kwargs[field]:
                 self.set_network(id, field, kwargs[field])
