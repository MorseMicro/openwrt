CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_morse_halowlink_apx=y
CONFIG_TARGET_ROOTFS_INITRAMFS=n

CONFIG_MORSE_SDIO_ALIGNMENT=8

CONFIG_TARGET_PREINIT_IP="192.168.12.1"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.12.255"

CONFIG_PACKAGE_morse-fw-6108-tlm=y
CONFIG_PACKAGE_mt7603e-txpat-artini=y

CONFIG_PACKAGE_persistent-vars-storage-ubootenv=y
